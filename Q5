import java.util.Random;

public class L4Q5 {
    public static void main(String[] args) {
        Random rand = new Random();
        
        int p1Score = 0;
        int p2Score = 0;
        int round = 1;
        
        while (p1Score <= 100 && p2Score <= 100) {
            System.out.println("--- Round " + round + " ---");
            
            // Player 1 turn
            System.out.print("Player 1 rolls: ");
            int roll;
            do {
                roll = rand.nextInt(6) + 1;
                p1Score += roll;
                System.out.print(roll + " ");
            } while (roll == 6);
            System.out.println("| Total Score: " + p1Score);
            
            if (p1Score > 100) break;
            
            // Player 2 turn
            System.out.print("Player 2 rolls: ");
            do {
                roll = rand.nextInt(6) + 1;
                p2Score += roll;
                System.out.print(roll + " ");
            } while (roll == 6);
            System.out.println("| Total Score: " + p2Score);
            
            round++;
            System.out.println();
        }
        
        System.out.println("\n==================================");
        if (p1Score > 100) {
            System.out.println("Player 1 wins with " + p1Score + " points!");
        } else {
            System.out.println("Player 2 wins with " + p2Score + " points!");
        }
    }
}
