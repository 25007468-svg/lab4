import java.util.Scanner;

public class L4Q1 {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        
        System.out.print("Enter an Integer: ");
        int num = scanner.nextInt();
        
        System.out.print("The factors are: ");
        boolean first = true;
        for (int i = 1; i <= num; i++) {
            if (num % i == 0) {
                if (!first) {
                    System.out.print(", ");
                }
                System.out.print(i);
                first = false;
            }
        }
        System.out.println();
        scanner.close();
    }
}
